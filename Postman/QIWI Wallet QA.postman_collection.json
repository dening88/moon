{
  "info": {
    "_postman_id": "0ea3e06a-4519-4b21-ba39-9cc7c3fd88c9",
    "name": "QIWI Wallet QA",
    "description": "Postman collection for QA test task: service availability, balance, payment creation and payment execution checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "3276693"
  },
  "item": [
    {
      "name": "Service availability - payment history",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const raw = pm.response.text();",
              "let body;",
              "",
              "if (pm.response.code === 200) {",
              "  pm.test('Response body is valid JSON', () => {",
              "    pm.expect(raw).to.not.equal('');",
              "    body = JSON.parse(raw);",
              "  });",
              "} else {",
              "  console.warn(`Service is unavailable or endpoint contract is broken: expected 200, got ${pm.response.code}`);",
              "  console.warn('Response contract checks skipped because successful response was not received.');",
              "}",
              "",
              "if (body) pm.test('Response has data array', () => pm.expect(body.data).to.be.an('array'));",
              "",
              "if (body && body.data.length) {",
              "  pm.test('Payment item has documented fields', () => {",
              "    pm.expect(body.data[0]).to.have.property('txnId');",
              "    pm.expect(body.data[0]).to.have.property('type');",
              "    pm.expect(body.data[0]).to.have.property('status');",
              "  });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{QIWI_BASE_URL}}/payment-history/v2/persons/{{QIWI_WALLET}}/payments?rows=1",
          "host": [
            "{{QIWI_BASE_URL}}"
          ],
          "path": [
            "payment-history",
            "v2",
            "persons",
            "{{QIWI_WALLET}}",
            "payments"
          ],
          "query": [
            {
              "key": "rows",
              "value": "1"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Balance - RUB account greater than 0",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const raw = pm.response.text();",
              "",
              "let body;",
              "let rub;",
              "",
              "if (pm.response.code === 200) {",
              "  pm.test('Response body is valid JSON', () => {",
              "    pm.expect(raw).to.not.equal('');",
              "    body = JSON.parse(raw);",
              "    rub = (body.accounts || []).find((account) => account.alias === 'qw_wallet_rub');",
              "  });",
              "} else {",
              "  console.warn(`Contract checks skipped: expected 200, got ${pm.response.code}`);",
              "}",
              "",
              "if (body) pm.test('RUB wallet account exists', () => pm.expect(rub).to.exist);",
              "",
              "if (rub) pm.test('RUB balance is greater than 0', () => {",
              "  pm.expect(rub.hasBalance).to.equal(true);",
              "  pm.expect(rub.balance.currency).to.equal(643);",
              "  pm.expect(rub.balance.amount).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{QIWI_BASE_URL}}/funding-sources/v2/persons/{{QIWI_WALLET}}/accounts",
          "host": [
            "{{QIWI_BASE_URL}}"
          ],
          "path": [
            "funding-sources",
            "v2",
            "persons",
            "{{QIWI_WALLET}}",
            "accounts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create payment - 1 RUB",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('paymentId', `${Date.now()}`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const raw = pm.response.text();",
              "let body;",
              "",
              "if (pm.response.code === 200) {",
              "  pm.test('Response body is valid JSON', () => {",
              "    pm.expect(raw).to.not.equal('');",
              "    body = JSON.parse(raw);",
              "  });",
              "} else {",
              "  console.warn(`Contract checks skipped: expected 200, got ${pm.response.code}`);",
              "}",
              "",
              "if (body) pm.test('Payment accepted for exactly 1 RUB', () => {",
              "  pm.expect(body.sum.amount).to.equal(1);",
              "  pm.expect(body.sum.currency).to.equal('643');",
              "  pm.expect(body.terms).to.equal('99');",
              "  pm.expect(body.transaction.state.code).to.be.oneOf(['Accepted', 'Completed']);",
              "});",
              "",
              "if (body && body.transaction && body.transaction.id) {",
              "  pm.collectionVariables.set('transactionId', body.transaction.id);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{paymentId}}\",\n  \"sum\": {\n    \"amount\": 1,\n    \"currency\": \"643\"\n  },\n  \"paymentMethod\": {\n    \"type\": \"Account\",\n    \"accountId\": \"643\"\n  },\n  \"comment\": \"QA test payment {{paymentId}}\",\n  \"fields\": {\n    \"account\": \"{{QIWI_RECIPIENT_WALLET}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{QIWI_BASE_URL}}/sinap/api/v2/terms/99/payments",
          "host": [
            "{{QIWI_BASE_URL}}"
          ],
          "path": [
            "sinap",
            "api",
            "v2",
            "terms",
            "99",
            "payments"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Payment execution - transaction status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const raw = pm.response.text();",
              "let body;",
              "",
              "if (pm.response.code === 200) {",
              "  pm.test('Response body is valid JSON', () => {",
              "    pm.expect(raw).to.not.equal('');",
              "    body = JSON.parse(raw);",
              "  });",
              "} else {",
              "  console.warn(`Contract checks skipped: expected 200, got ${pm.response.code}`);",
              "}",
              "",
              "if (body) pm.test('Transaction has execution status and amount', () => {",
              "  pm.expect(body.type).to.equal('OUT');",
              "  pm.expect(body.status).to.be.oneOf(['WAITING', 'SUCCESS', 'ERROR']);",
              "  pm.expect(body.sum.amount).to.equal(1);",
              "  pm.expect(body.sum.currency).to.equal(643);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{QIWI_BASE_URL}}/payment-history/v2/transactions/{{transactionId}}?type=OUT",
          "host": [
            "{{QIWI_BASE_URL}}"
          ],
          "path": [
            "payment-history",
            "v2",
            "transactions",
            "{{transactionId}}"
          ],
          "query": [
            {
              "key": "type",
              "value": "OUT"
            }
          ]
        }
      },
      "response": []
    }
  ],
